// Copy to secrets.h (gitignored) to let "Wi-Fi transfer" join your home network
// instead of starting the reader's own network. Without secrets.h the reader
// always starts its own network (SSID T5-Reader-XXXX, password on screen).
#pragma once

#define WIFI_SSID "my-home-network"
#define WIFI_PASSWORD "my-wifi-password"
