// Copy to secrets.h (gitignored) to let "Wi-Fi transfer" join your home network
// instead of starting the reader's own network. Without secrets.h the reader
// always starts its own network (SSID T5-Reader-XXXX, password on screen).
#pragma once

#define WIFI_SSID "my-home-network"
#define WIFI_PASSWORD "my-wifi-password"

// Optional: the book server (Home Assistant add-on, docs/book-server.md) for
// Menu -> Book server, if none is entered on the page.
// #define BOOK_SERVER "http://192.168.1.10:8484"

// The MQTT broker for the reading position sync (docs/progress-sync.md), if not
// entered on the reader's page (the page's comes first).
// #define MQTT_BROKER "192.168.1.10"
// #define MQTT_USER "t5reader"
// #define MQTT_PASSWORD "my-mqtt-password"
